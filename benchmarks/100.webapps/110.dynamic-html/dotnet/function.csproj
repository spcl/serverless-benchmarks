<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- DOTNET_VERSION is set by the build image. -->
    <TargetFramework>net$(DOTNET_VERSION).0</TargetFramework>
    <!-- Part of the platform handler strings. -->
    <AssemblyName>function</AssemblyName>
    <Nullable>enable</Nullable>
    <!-- Required by the runtime; not generated for libraries by default. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stubble.Core" Version="1.10.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copied here by init.sh -->
    <EmbeddedResource Include="templates/template.html" LogicalName="template.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- PLATFORM_DEPENDENCIES -->
  </ItemGroup>

</Project>
