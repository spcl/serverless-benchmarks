ARG BASE_IMAGE
FROM $BASE_IMAGE
ARG TARGET_ARCHITECTURE

COPY . function/

ENV PLATFORM_ARG=""

RUN touch function/__init__.py \
    && if [[ "${TARGET_ARCHITECTURE}" == "arm64" ]]; then \
      export PLATFORM_ARG="--platform manylinux_2_17_aarch64 --only-binary=:all:"; \
    fi \
    && pip install --no-cache-dir --require-hashes ${PLATFORM_ARG} --target . \
        -r function/requirements.txt \
    && pip install --no-cache-dir --no-deps --target . function/ \
    && pip cache purge

CMD ["function/handler.handler"]
