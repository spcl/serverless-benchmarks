ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG VERSION
ENV NVM_DIR=/nvm

RUN apt-get update\
  && apt-get install -y --no-install-recommends ca-certificates zip gosu curl net-tools python3 sudo\
  && apt-get purge -y --auto-remove \
  && update-ca-certificates \
  && mkdir -p ${NVM_DIR} && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash \
  && . ${NVM_DIR}/nvm.sh && nvm install ${VERSION} && nvm alias default ${VERSION} && nvm use default\
  && ln -s ${NVM_DIR}/versions/node/$(nvm version default) ${NVM_DIR}/current

ENV SCRIPT_FILE=/mnt/function/package.sh
# ENV cannot evaluate commands, so we refer to the installed version through a symlink
ENV PATH="${NVM_DIR}/current/bin:$PATH"

RUN mkdir -p /sebs
# Dependencies of the SeBS server and runners, locked by tools/lock_nodejs_benchmarks.py.
# Functions install their own dependencies.
COPY dockerfiles/local/nodejs/package.json dockerfiles/local/nodejs/package-lock.json /sebs/
RUN cd /sebs && npm ci --omit=dev && npm cache clean --force

COPY dockerfiles/local/*.py /sebs/
COPY dockerfiles/local/run.sh /sebs/
COPY dockerfiles/local/nodejs/*.js /sebs/
COPY dockerfiles/local/nodejs/run_server.sh /sebs/
COPY dockerfiles/local/nodejs/timeit.sh /sebs/
COPY dockerfiles/local/nodejs/runners.json /sebs/

COPY dockerfiles/local/entrypoint.sh /sebs/entrypoint.sh
RUN chmod +x /sebs/entrypoint.sh
RUN chmod +x /sebs/run.sh

ENTRYPOINT ["/sebs/entrypoint.sh"]
