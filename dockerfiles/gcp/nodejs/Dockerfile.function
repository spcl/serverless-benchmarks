ARG BASE_IMAGE
FROM $BASE_IMAGE

WORKDIR /workspace

USER root

COPY . function/
RUN mv function/handler.js function/package.json function/package-lock.json /workspace

ENV NODE_ENV=production

RUN npm ci --omit=dev \
    && npm cache clean --force

CMD ["node", "./node_modules/@google-cloud/functions-framework/build/src/main.js", "--target=handler", "--source=handler.js"]
